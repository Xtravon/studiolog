# Copy to .env and fill in. Never commit real secrets.
# Keep the DB outside any cloud-synced folder (SQLite + live sync can lock/corrupt).
# Example (Windows): file:C:/Users/YOU/AppData/Local/studiolog/data/studiolog.db
DATABASE_URL="file:./data/studiolog.db"
# Optional absolute uploads dir. Example (Windows): C:/Users/YOU/AppData/Local/studiolog/data/uploads
UPLOADS_DIR=""
# Uploads: local disk by default. Production has no disk, so pick a blob backend:
#   UPLOADS_PROVIDER=netlify (Netlify Blobs, needs USE_BLOBS=true there) or
#   UPLOADS_PROVIDER=vercel (Vercel Blob, needs BLOB_READ_WRITE_TOKEN there).
UPLOADS_PROVIDER=""
# Production (Netlify): set USE_BLOBS=true so photos use Netlify Blobs (no disk there).
USE_BLOBS=""
BETTER_AUTH_SECRET="generate-with-openssl-rand-hex-32"
BETTER_AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@studiolog.local"
ADMIN_PASSWORD="change-me"
