// StudioLog — Postgres twin for production (Neon). GENERATED — do not edit; edit schema.prisma then run npm run db:schema:pg.
// Better Auth tables (user/session/account/verification) + StudioLog Company.
// SQLite on local drive. Generator output is git-ignored (app/generated).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  // StudioLog: two user groups; adminRole set only when group = "admin".
  group     String  @default("customer")
  adminRole String?

  shipments Shipment[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  isPrimary Boolean  @default(false)
  contact   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shipments Shipment[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  includes    String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shipments   Shipment[]
}

enum ShipmentStatus {
  draft
  confirmed
  pickup_scheduled
  collected
  in_transit
  near_destination
  delivered
  completed
  cancelled
}

model Shipment {
  id             String         @id @default(cuid())
  customerId     String
  customer       User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?       @relation(fields: [serviceId], references: [id])
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id])
  goodsDesc      String         @default("")
  quantity       String         @default("")
  weightKg       Float?
  dimensions     String         @default("")
  photos         Json           @default("[]")
  handlingNotes  String         @default("")
  pickupAddr     String         @default("")
  deliveryAddr   String         @default("")
  pickupTimePref String         @default("")
  status         ShipmentStatus @default(draft)
  consultations  Consultation[]
  plans          ShipmentPlan[]
  payments       Payment[]
  events         TrackingEvent[]
  issues         Issue[]
  distanceKm     Float?
  pickupLat      Float?
  pickupLng      Float?
  deliveryLat    Float?
  deliveryLng    Float?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model PricingConfig {
  id             String   @id @default(cuid())
  perKmRate      Float
  baseFee        Float
  minimumCharge  Float
  currency       String   @default("NGN")
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

enum ConsultationMode {
  phone
  video
}

enum ConsultationStatus {
  booked
  done
  cancelled
  no_show
}

enum PlanStatus {
  pending
  approved
  correction_requested
  superseded
}

model ShipmentPlan {
  id                String     @id @default(cuid())
  shipmentId        String
  shipment          Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  version           Int
  serviceId         String?
  companyId         String?
  serviceName       String     @default("")
  companyName       String     @default("")
  goodsDesc         String     @default("")
  quantity          String     @default("")
  weightKg          Float?
  dimensions        String     @default("")
  photos            Json       @default("[]")
  handlingNotes     String     @default("")
  pickupAddr        String     @default("")
  deliveryAddr      String     @default("")
  pickupTimePref    String     @default("")
  handlerStatement  String     @default("Handled by LAS Transport Limited")
  distanceKm        Float      @default(0)
  transportCharge   Float      @default(0)
  handlingFee       Float      @default(0)
  totalPrice        Float      @default(0)
  currency          String     @default("NGN")
  timingEstimate    String     @default("")
  conditions        String     @default("")
  status            PlanStatus @default(pending)
  correctionNote    String     @default("")
  createdBy         String?
  createdAt         DateTime   @default(now())
  payments          Payment[]

  @@unique([shipmentId, version])
}

enum PaymentStatus {
  pending
  success
  failed
}

model Payment {
  id          String        @id @default(cuid())
  shipmentId  String
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  planId      String
  plan        ShipmentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String        @default("NGN")
  provider    String        @default("test")
  providerRef String        @unique
  status      PaymentStatus @default(pending)
  createdAt   DateTime      @default(now())
}

model TrackingEvent {
  id             String   @id @default(cuid())
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  milestone      String
  message        String   @default("")
  actionRequired Boolean  @default(false)
  createdBy      String?
  createdAt      DateTime @default(now())
}

enum IssueStatus {
  open
  resolved
}

model Issue {
  id         String      @id @default(cuid())
  shipmentId String
  shipment   Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  customerId String
  message    String
  status     IssueStatus @default(open)
  createdAt  DateTime    @default(now())
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String
  shipmentId String?
  userId     String?
  data       String   @default("{}")
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  detail    String   @default("")
  createdAt DateTime @default(now())
}

model Consultation {
  id                String             @id @default(cuid())
  shipmentId        String
  shipment          Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  customerId        String
  salesRepId        String?
  mode              ConsultationMode   @default(phone)
  scheduledAt       DateTime?
  meetingLink       String             @default("")
  note              String             @default("")
  status            ConsultationStatus @default(booked)
  callbackRequested Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}
